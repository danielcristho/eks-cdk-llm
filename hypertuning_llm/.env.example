# EKS LLM env config

#! AWS config
AWS_DEFAULT_ACCOUNT=123456789012
AWS_DEFAULT_REGION=us-east-1
AWS_ADMIN_USER=<your-iam-user1,your-iam-user2>
AWS_BUCKET=<your-model-bucket>

AWS_CLI_IMAGE=amazon/aws-cli:2.17.62


#! EKS config and node config
CLUSTER_NAME=eks-llm-pipeline

GPU_INSTANCE_TYPE=g4dn.xlarge

#! vLLM config and model
VLLM_URL=<vllm-endpoint>:8000>
VLLM_VERSION=0.8.5
VLLM_MAX_REPLICAS=2

SERVED_MODEL_NAME=qwen-lora
DTYPE=half
QUANTIZATION=awq
MAX_MODEL_LEN=4096

#! GitOps: Argo CD syncs manifests/vllm from this repo and branch.
#! The served model is modelPrefix in manifests/vllm/values.yaml, not here.
GITOPS_REPO_URL=https://github.com/danielcristho/eks-cdk-mlops.git
GITOPS_REVISION=main

#! Ray config
RAY_VERSION=2.43.0

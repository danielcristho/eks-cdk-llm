# AWS Config
AWS_DEFAULT_ACCOUNT=123456789012
AWS_DEFAULT_REGION=us-east-1
AWS_ADMIN_USER=your_aws_username
AWS_BUCKET=eks-llm-scale-model-bucket

# EKS Config
CLUSTER_NAME=eks-llm-scale

# VLLM Config
# VLLM_URL will be added later after the deployment is live, get it via:
#   kubectl get svc vllm-nlb -n kuberay -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'
VLLM_URL=
